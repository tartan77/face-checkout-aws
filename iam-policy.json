{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RekognitionCollectionAccess",
      "Effect": "Allow",
      "Action": [
        "rekognition:IndexFaces",
        "rekognition:SearchFacesByImage"
      ],
      "Resource": "arn:aws:rekognition:ap-south-1:ACCOUNT_ID:collection/customers-faces"
    },
    {
      "Sid": "DynamoDBTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:ACCOUNT_ID:table/*"
    }
  ]
}
